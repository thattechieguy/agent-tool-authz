# Required user inputs
# API app registration client id (audience app)
AAB_APP_REGISTRATION_CLIENT_ID=<your-app-registration-client-id>
# Caller/client app registration client id
AAB_CALLER_APP_REGISTRATION_CLIENT_ID=<your-caller-app-registration-client-id>
AAB_TENANT_ID=<your-tenant-id>
AAB_APIM_NAME=<your-apim-name>
AAB_RESOURCE_GROUP_NAME=<your-resource-group-name>
AAB_SUBSCRIPTION_ID=<your-subscription-id>

# Target endpoints
AAB_TARGET_GATEWAY_URL=http://127.0.0.1:8080
AAB_BACKEND_URL=http://127.0.0.1:9000

# Token options:
# 1) set AAB_ACCESS_TOKEN directly, or
# 2) let CLI mint one using az account get-access-token with resource/scope below
AAB_ACCESS_TOKEN=
AAB_TOKEN_RESOURCE=https://management.azure.com/
AAB_TOKEN_SCOPE=

# Optional: run-context/approval tokens if your gateway requires them
AAB_RUN_CONTEXT_TOKEN=
AAB_APPROVAL_TOKEN=
