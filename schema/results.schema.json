{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Run results",
  "type": "object",
  "required": ["tool_version", "label", "timestamp", "environment", "scenarios"],
  "properties": {
    "tool_version": { "type": "string" },
    "label": { "type": "string" },
    "timestamp": { "type": "string" },
    "environment": { "type": "object" },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "outcome", "steps", "state_assertions"],
        "properties": {
          "id": { "type": "string" },
          "outcome": { "enum": ["PASS", "FAIL", "SKIP"] },
          "steps": { "type": "array" },
          "state_assertions": { "type": "array" }
        }
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "pass_count": { "type": "integer", "minimum": 0 },
        "total_count": { "type": "integer", "minimum": 0 },
        "pass_rate": { "type": "number", "minimum": 0, "maximum": 1 },
        "critical_failures": { "type": "array", "items": { "type": "string" } },
        "critical_pass_rate": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
